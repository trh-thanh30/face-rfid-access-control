NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

API_PORT=3000
PORT=3000
ADMIN_PORT=3001
ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
VISION_URL=http://localhost:8001

DB_HOST=localhost
DB_PORT=15432
DB_USER=access_control_user
DB_PASSWORD=access_control_password
DB_NAME=access_control
DATABASE_URL=postgresql://access_control_user:access_control_password@localhost:15432/access_control?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
RFID_HASH_KEY=replace-with-an-independent-random-secret

DEVICE_CODE=ESP32_DOOR_01
DEVICE_TOKEN=development-device-token
DEVICE_OFFLINE_THRESHOLD_SECONDS=30
AUTH_SESSION_TTL_SECONDS=10
ACTUATION_COMMAND_TTL_SECONDS=5
ACTUATION_OPEN_DURATION_MS=3000
FAKE_FACE_MODE=allow

VISION_SERVICE_NAME=access-control-vision
VISION_MODEL_VERSION=not-loaded
VISION_CAMERA_PROVIDER=fixture
